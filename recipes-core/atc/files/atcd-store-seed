#!/bin/sh
# Seed the atcd store at /var/atc with the image's atcd. atcd-store-seed.service
# runs it as root until the store holds the done marker.
#
# The store has three states, and the markers tell them apart:
#   no atcd binary           an empty store: write the started marker, seed it
#   link and started marker  a seed that a power cut or an error stopped:
#                            repeat the grants, which are safe to repeat
#   link, no started marker  a store that `atc bootstrap` filled: change nothing
# Each path ends with the done marker, written last. The unit skips a store
# that has it, so a seed that stops before the end runs again on the next boot.
set -eu

STORE=/var/atc
SEED=/usr/bin/atcd
LINK="$STORE/channel/agency/atcd/delivery/current/atcd/atcd"
STARTED="$STORE/.atcd-seed-started"
DONE="$STORE/.atcd-seed-done"

if [ ! -e "$LINK" ]; then
  touch "$STARTED"
  sync
  "$SEED" install-self --from "$SEED" --store-root "$STORE"
fi

if [ -e "$STARTED" ]; then
  chown -R atc:atc "$STORE"

  # atcd's service user reaches the binary through group traverse on each
  # directory of the path, the same grant `atc bootstrap` makes.
  target="$(readlink -f "$LINK")"
  for p in "$target" "$LINK"; do
    d="$(dirname "$p")"
    while [ "$d" != "$STORE" ] && [ "$d" != / ]; do
      [ -L "$d" ] || chmod g+x "$d"
      d="$(dirname "$d")"
    done
  done
  chmod g+x "$STORE"

  # The hook log directory, as `atc bootstrap` makes it for the atc-hooks user.
  install -d -o atc -g atc -m 0750 "$STORE/logs" "$STORE/logs/hooks"
fi

sync
touch "$DONE"
sync
