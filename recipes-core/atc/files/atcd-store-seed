#!/bin/sh
# Seed the atcd store at /var/atc with the image's atcd. atcd-store-seed.service
# runs it as root on each boot until the store holds the done marker.
#
# The done marker means "user atc can run the store's atcd". The script writes
# it last, and only after it checks that as user atc. A link alone proves
# nothing: install-self writes the link before the grants, and a power cut
# between them, here or in `atc bootstrap`, leaves a store that atc cannot
# open. Each step below is safe to repeat:
#   - install-self runs only when the link gives no binary, so a bootstrapped
#     or self-updated atcd is kept;
#   - the grants run only when atc cannot run the binary, so a healthy store
#     is not changed.
# A run that cannot make the store runnable exits non-zero and writes no
# marker, so the next boot tries again.
set -eu

STORE=/var/atc
SEED=/usr/bin/atcd
LINK="$STORE/channel/agency/atcd/delivery/current/atcd/atcd"
DONE="$STORE/.atcd-seed-done"

# Succeed when user atc can run the store's atcd. The store path holds no
# quote or space, so it is safe inside the command string.
runnable() {
  su -s /bin/sh -c "test -s '$LINK' && test -x '$LINK'" atc
}

if [ ! -s "$LINK" ]; then
  "$SEED" install-self --from "$SEED" --store-root "$STORE"
fi

if ! runnable; then
  chown -R atc:atc "$STORE"
  # atcd's service user reaches the binary through group traverse on each
  # directory of the path, the same grant `atc bootstrap` makes.
  target="$(readlink -f "$LINK")"
  for p in "$target" "$LINK"; do
    d="$(dirname "$p")"
    while [ "$d" != "$STORE" ] && [ "$d" != / ]; do
      [ -L "$d" ] || chmod g+x "$d"
      d="$(dirname "$d")"
    done
  done
  chmod g+x "$STORE"
fi

# The hook log directory, as `atc bootstrap` makes it for the atc-hooks user.
[ -d "$STORE/logs/hooks" ] || install -d -o atc -g atc -m 0750 "$STORE/logs" "$STORE/logs/hooks"

runnable || {
  echo "atcd-store-seed: user atc cannot run $LINK; the next boot tries again" >&2
  exit 1
}
sync
touch "$DONE"
sync
